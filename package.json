{
  "name": "@instantreply.co/mcp",
  "version": "0.2.1",
  "mcpName": "co.instantreply/mcp",
  "description": "AI agent toolkit for WhatsApp, Instagram, and Messenger automation with zero-key MCP pairing, Barq AI, inbox tools, campaigns, templates, and developer diagnostics.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "instantreply-mcp": "dist/index.js"
  },
  "homepage": "https://instantreply.co/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suleimandoescsec/instantreply-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/suleimandoescsec/instantreply-mcp/issues"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "ai-agents",
    "instantreply",
    "whatsapp",
    "whatsapp-api",
    "instagram",
    "instagram-api",
    "messenger",
    "meta-api",
    "customer-support",
    "marketing-automation",
    "lead-generation",
    "conversational-ai",
    "claude",
    "chatgpt",
    "cursor",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.7",
    "ip-address": "10.4.0",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
