{
  "name": "@instantreply/mcp",
  "version": "0.2.0",
  "mcpName": "io.github.suleimandoescsec/instantreply-mcp",
  "description": "InstantReply MCP server — connect your AI inbox to any LLM agent. No account yet? Run it and the agent walks you through setup.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "instantreply-mcp": "./dist/index.js"
  },
  "homepage": "https://instantreply.co/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suleimandoescsec/instantreply-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/suleimandoescsec/instantreply-mcp/issues"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "instantreply",
    "inbox",
    "ai",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.7",
    "ip-address": "10.4.0",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
